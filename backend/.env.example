# ===========================================
# IKU AI Backend Environment Variables Template
# ===========================================
# 이 파일을 복사해서 .env로 만들고 실제 값을 입력하세요

# ========== 스프링 프로파일 ==========
SPRING_PROFILES_ACTIVE=local

# ========== 데이터베이스 설정 ==========
DB_URL=jdbc:postgresql://localhost:5432/iku-ai-db
DB_USERNAME=user
DB_PASSWORD=your_db_password
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# ========== JPA/Hibernate 설정 ==========
DDL_AUTO=update
SHOW_SQL=true
FORMAT_SQL=true
HBM2DDL_AUTO=update
FLYWAY_ENABLED=false

# ========== 로깅 설정 ==========
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_HIBERNATE=INFO
LOG_LEVEL_WEB=DEBUG

# ========== JWT 설정 ==========
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
JWT_GUEST_EXPIRATION=3600000

# ========== Clerk 인증 ==========
CLERK_DOMAIN=your-clerk-domain.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# ========== 외부 API 키 ==========
GEMINI_API_KEY=your_gemini_api_key
RIOT_API_KEY=your_riot_api_key

# ========== Naver API (선택사항) ==========
NAVER_API_ID=your_naver_api_id
NAVER_API_SECRET=your_naver_api_secret

# ========== 기타 설정 ==========
CHAT_STORAGE_DIR=./md-reports
MANAGEMENT_ENDPOINTS=health,info,metrics
HEALTH_SHOW_DETAILS=when_authorized
