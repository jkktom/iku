# Backend Dev 브랜치용 Dockerfile (개발 모드)
FROM openjdk:17-jdk-slim

WORKDIR /app

# 개발용 패키지 설치
RUN apt-get update && apt-get install -y \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Gradle Wrapper 복사
COPY gradlew .
COPY gradle gradle
COPY build.gradle .
COPY settings.gradle .

# 소스 코드 복사
COPY src src

# 실행 권한 부여
RUN chmod +x ./gradlew

# 의존성 미리 다운로드 (캐싱 최적화)
RUN ./gradlew dependencies

# 개발 모드로 실행 (Hot reload 지원)
EXPOSE 8080
CMD ["./gradlew", "bootRun", "--continuous"]
